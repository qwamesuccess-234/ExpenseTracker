<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="1280.0" prefHeight="800.0" maxWidth="Infinity" maxHeight="Infinity"
            style="-fx-background-color: #F5F6FA;"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo.controller.ApprovalsController">

    <left>
        <VBox prefWidth="260.0" spacing="6.0" style="-fx-background-color: #1C2130;">
            <padding><Insets top="32.0" left="20.0" right="20.0" /></padding>
            <children>
                <Label text="ExpenseTracker" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
                <Region prefHeight="28.0" />
                <Button text="Dashboard" maxWidth="Infinity" onAction="#goToDashboard" style="-fx-background-color: transparent; -fx-text-fill: #C0C2CB; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" />
                <Button text="Approvals" maxWidth="Infinity" style="-fx-background-color: #3868F2; -fx-text-fill: white; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" />
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0">
            <padding><Insets top="32.0" left="36.0" right="36.0" /></padding>
            <children>
                <Label text="Pending Approvals" style="-fx-font-size: 22px; -fx-font-weight: bold;" />
                <TableView fx:id="pendingTable" prefHeight="560.0">
                    <columns>
                        <TableColumn fx:id="dateColumn" text="Date" prefWidth="130.0" />
                        <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="260.0" />
                        <TableColumn fx:id="departmentColumn" text="Department" prefWidth="150.0" />
                        <TableColumn fx:id="amountColumn" text="Amount" prefWidth="120.0" />
                        <TableColumn fx:id="actionColumn" text="Action" prefWidth="220.0" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>