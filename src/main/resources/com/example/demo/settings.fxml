<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="520.0" prefWidth="920.0" style="-fx-background-color: #F5F6FA;"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo.controller.SettingsController">

    <left>
        <VBox prefWidth="260.0" spacing="6.0" style="-fx-background-color: #1C2130;">
            <padding><Insets top="32.0" left="20.0" right="20.0" /></padding>
            <children>
                <Label text="💰 ExpenseTracker" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
                <Region prefHeight="28.0" />
                <Button text="Dashboard" maxWidth="Infinity" onAction="#goToDashboard" style="-fx-background-color: transparent; -fx-text-fill: #C0C2CB; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" />
                <Button text="Settings" maxWidth="Infinity" style="-fx-background-color: #3868F2; -fx-text-fill: white; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" />
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0">
            <padding><Insets top="32.0" left="36.0" right="36.0" /></padding>
            <children>
                <Label text="Settings" style="-fx-font-size: 22px; -fx-font-weight: bold;" />

                <VBox spacing="18.0" prefWidth="600.0" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 28;">
                    <children>
                        <Label text="Account Info" style="-fx-font-size: 15px; -fx-font-weight: bold;" />
                        <Label text="Full Name" style="-fx-font-size: 12px; -fx-text-fill: #8C919E;" />
                        <TextField fx:id="nameField" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E1E8; -fx-padding: 10;" />
                        <Label text="Email" style="-fx-font-size: 12px; -fx-text-fill: #8C919E;" />
                        <TextField fx:id="emailField" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E1E8; -fx-padding: 10;" />
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Dark Mode" />
                                <Region HBox.hgrow="ALWAYS" />
                                <CheckBox fx:id="darkModeToggle" />
                            </children>
                        </HBox>

                        <VBox fx:id="teamSection" spacing="10.0" visible="false" managed="false">
                            <children>
                                <Label text="Add Team Member" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                                <TextField fx:id="memberEmailField" promptText="Team member's registered email" />
                                <Button text="Add to Team" onAction="#handleAddTeamMember" style="-fx-background-color: #3868F2; -fx-text-fill: white; -fx-background-radius: 8;" />
                            </children>
                        </VBox>

                        <HBox spacing="12.0">
                            <children>
                                <Button text="Save Changes" onAction="#handleSave" style="-fx-background-color: #3868F2; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-pref-height: 44; -fx-pref-width: 180;" />
                                <Button text="Logout" onAction="#handleLogout" style="-fx-background-color: white; -fx-border-color: #E0E1E8; -fx-background-radius: 8; -fx-pref-height: 44; -fx-pref-width: 140;" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>