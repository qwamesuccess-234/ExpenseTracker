<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" style="-fx-background-color: #F5F6FA;"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo.controller.CategoriesController">

    <left>
        <VBox prefWidth="260.0" spacing="6.0" style="-fx-background-color: #1C2130;">
            <padding><Insets top="32.0" left="20.0" right="20.0" /></padding>
            <children>
                <Label text="💰 ExpenseTracker" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
                <Region prefHeight="28.0" />
                <Button text="Dashboard" maxWidth="Infinity" onAction="#goToDashboard" style="-fx-background-color: transparent; -fx-text-fill: #C0C2CB; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" />
                <Button text="Categories" maxWidth="Infinity" style="-fx-background-color: #3868F2; -fx-text-fill: white; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" />
                <Button text="Expenses" maxWidth="Infinity" onAction="#goToExpenseList" style="-fx-background-color: transparent; -fx-text-fill: #C0C2CB; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" />
                <Button text="Budget" maxWidth="Infinity" onAction="#goToBudget" style="-fx-background-color: transparent; -fx-text-fill: #C0C2CB; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" />
                <Button text="Reports" maxWidth="Infinity" onAction="#goToReports" style="-fx-background-color: transparent; -fx-text-fill: #C0C2CB; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" />
                <Button text="Settings" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #C0C2CB; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" />
                <Region VBox.vgrow="ALWAYS" />

            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0">
            <padding><Insets top="32.0" left="36.0" right="36.0" /></padding>
            <children>
                <Label text="Categories" style="-fx-font-size: 22px; -fx-font-weight: bold;" />

                <HBox spacing="12.0">
                    <children>
                        <TextField fx:id="nameField" promptText="Category name" prefWidth="220.0" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E1E8;" />
                        <TextField fx:id="typeField" promptText="Type (e.g. Expense)" prefWidth="180.0" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E1E8;" />
                        <Button text="+ Add Category" onAction="#handleAdd" style="-fx-background-color: #3868F2; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold;" />
                    </children>
                </HBox>
                <Label fx:id="errorLabel" style="-fx-text-fill: #E64D4D; -fx-font-size: 12px;" />

                <TableView fx:id="categoryTable" prefHeight="500.0">
                    <columns>
                        <TableColumn fx:id="nameColumn" text="Name" prefWidth="300.0" />
                        <TableColumn fx:id="typeColumn" text="Type" prefWidth="220.0" />
                        <TableColumn fx:id="actionColumn" text="Action" prefWidth="150.0" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>