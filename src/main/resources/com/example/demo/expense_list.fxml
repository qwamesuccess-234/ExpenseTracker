<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" style="-fx-background-color: #F5F6FA;"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo.controller.ExpenseListController">

    <left>
        <VBox prefWidth="260.0" spacing="6.0" style="-fx-background-color: #1C2130;">
            <padding><Insets top="32.0" left="20.0" right="20.0" /></padding>
            <children>
                <Label text="💰 ExpenseTracker" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
                <Region prefHeight="28.0" />
                <Button text="Dashboard" maxWidth="Infinity" onAction="#goToDashboard" style="-fx-background-color: transparent; -fx-text-fill: #C0C2CB; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" />
                <Button text="Expenses" maxWidth="Infinity" style="-fx-background-color: #3868F2; -fx-text-fill: white; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" />
                <Button text="Budget" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #C0C2CB; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" />
                <Button text="Reports" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #C0C2CB; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" />
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0">
            <padding><Insets top="32.0" left="36.0" right="36.0" /></padding>
            <children>
                <Label text="Expenses" style="-fx-font-size: 22px; -fx-font-weight: bold;" />

                <HBox spacing="12.0">
                    <children>
                        <TextField fx:id="searchField" promptText="Search expenses..." prefWidth="280.0" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E1E8;" />
                        <ComboBox fx:id="categoryFilter" promptText="Category" prefWidth="170.0" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Export CSV" onAction="#handleExport" style="-fx-background-color: white; -fx-border-color: #E0E1E8; -fx-background-radius: 8; -fx-padding: 10;" />
                    </children>
                </HBox>

                <TableView fx:id="expenseTable" prefHeight="560.0">
                    <columns>
                        <TableColumn fx:id="dateColumn" text="Date" prefWidth="140.0" />
                        <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="280.0" />
                        <TableColumn fx:id="categoryColumn" text="Category" prefWidth="160.0" />
                        <TableColumn fx:id="amountColumn" text="Amount" prefWidth="130.0" />
                        <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="160.0" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>