<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane maxHeight="Infinity" maxWidth="Infinity" prefHeight="700" prefWidth="1300" style="-fx-background-color: #F5F6FA;"
           xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.demo.controller.EditExpenseController">

    <VBox maxWidth="-Infinity" prefWidth="480.0" spacing="16.0"
          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 32;"
          StackPane.alignment="CENTER">
        <children>
            <Label text="Edit Expense" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1C2130;" />
            <Label fx:id="errorLabel" style="-fx-text-fill: #E64D4D; -fx-font-size: 12px;" />

            <Label text="Amount ($)" style="-fx-font-size: 12px; -fx-text-fill: #8C919E;" />
            <TextField fx:id="amountField" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E1E8; -fx-padding: 10;" />

            <Label text="Description" style="-fx-font-size: 12px; -fx-text-fill: #8C919E;" />
            <TextField fx:id="descriptionField" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E1E8; -fx-padding: 10;" />

            <Label text="Category" style="-fx-font-size: 12px; -fx-text-fill: #8C919E;" />
            <ComboBox fx:id="categoryCombo" maxWidth="Infinity" />

            <Label text="Date" style="-fx-font-size: 12px; -fx-text-fill: #8C919E;" />
            <DatePicker fx:id="datePicker" maxWidth="Infinity" />

            <HBox spacing="12.0">
                <children>
                    <Button text="Update" onAction="#handleUpdate" style="-fx-background-color: #3868F2; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-pref-height: 44; -fx-pref-width: 160;" />
                    <Button text="Delete" onAction="#handleDelete" style="-fx-background-color: #E64D4D; -fx-text-fill: white; -fx-background-radius: 8; -fx-pref-height: 44; -fx-pref-width: 120;" />
                    <Button text="Cancel" onAction="#handleCancel" style="-fx-background-color: white; -fx-border-color: #E0E1E8; -fx-background-radius: 8; -fx-pref-height: 44; -fx-pref-width: 120;" />
                </children>
            </HBox>
        </children>
    </VBox>
</StackPane>