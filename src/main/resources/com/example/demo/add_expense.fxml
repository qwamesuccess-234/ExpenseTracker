<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.CheckBox?>

<StackPane fx:id="rootPane" maxHeight="Infinity" maxWidth="Infinity" prefHeight="720" prefWidth="1350" style="-fx-background-color: #F5F6FA;"
           xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.demo.controller.AddExpenseController">

    <VBox maxWidth="-Infinity" prefWidth="480.0" spacing="16.0"
          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 32;"
          StackPane.alignment="CENTER">
        <children>
            <Label text="Add New Expense" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1C2130;" />
            <Label fx:id="errorLabel" style="-fx-text-fill: #E64D4D; -fx-font-size: 12px;" />

            <Label text="Amount ($)" style="-fx-font-size: 12px; -fx-text-fill: #8C919E;" />
            <TextField fx:id="amountField" promptText="0.00" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E1E8; -fx-padding: 10;" />

            <Label text="Description" style="-fx-font-size: 12px; -fx-text-fill: #8C919E;" />
            <TextField fx:id="descriptionField" promptText="e.g. Grocery shopping" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E1E8; -fx-padding: 10;" />

            <Label text="Category" style="-fx-font-size: 12px; -fx-text-fill: #8C919E;" />
            <ComboBox fx:id="categoryCombo" maxWidth="Infinity" promptText="Select category" />

            <Label fx:id="departmentLabel" text="Department" style="-fx-font-size: 12px; -fx-text-fill: #8C919E;" visible="false" managed="false" />
            <TextField fx:id="departmentField" promptText="e.g. Marketing, Sales" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E1E8; -fx-padding: 10;" visible="false" managed="false" />

            <!-- New: allow user to choose whether this is a company expense or personal -->
            <CheckBox fx:id="companyCheckbox" text="Company expense" />

            <Button text="Attach Receipt" onAction="#handleAttachReceipt" style="-fx-background-color: white; -fx-border-color: #E0E1E8; -fx-background-radius: 8; -fx-padding: 10;" />
            <Label fx:id="receiptLabel" style="-fx-font-size: 11px; -fx-text-fill: #8C919E;" />

            <Label text="Date" style="-fx-font-size: 12px; -fx-text-fill: #8C919E;" />
            <DatePicker fx:id="datePicker" maxWidth="Infinity" />

            <HBox spacing="12.0">
                <children>
                    <Button text="Save Expense" onAction="#handleSave" style="-fx-background-color: #3868F2; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-pref-height: 44; -fx-pref-width: 200;" />
                    <Button text="Cancel" onAction="#handleCancel" style="-fx-background-color: white; -fx-border-color: #E0E1E8; -fx-background-radius: 8; -fx-pref-height: 44; -fx-pref-width: 140;" />
                </children>
            </HBox>
        </children>
    </VBox>
</StackPane>
