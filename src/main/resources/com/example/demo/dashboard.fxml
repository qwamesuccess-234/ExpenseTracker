<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<BorderPane prefHeight="520.0" prefWidth="920.0" style="-fx-background-color: #F5F6FA;"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo.controller.DashboardController">

    <left>
        <VBox prefWidth="260.0" spacing="6.0" style="-fx-background-color: #1C2130;">
            <padding><Insets top="32.0" left="20.0" right="20.0" /></padding>
            <children>
                <Label text="💰 ExpenseTracker" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
                <Region prefHeight="28.0" />
                <Button text="Dashboard" maxWidth="Infinity" style="-fx-background-color: #3868F2; -fx-text-fill: white; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" />
                <Button text="Expenses" maxWidth="Infinity" onAction="#goToExpenseList" style="-fx-background-color: transparent; -fx-text-fill: #C0C2CB; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" />
                <Button text="Budget" maxWidth="Infinity" onAction="#goToBudget" style="-fx-background-color: transparent; -fx-text-fill: #C0C2CB; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" />
                <Button text="Reports" maxWidth="Infinity" onAction="#goToReports" style="-fx-background-color: transparent; -fx-text-fill: #C0C2CB; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" />
                <Button text="Categories" maxWidth="Infinity" onAction="#goToCategories" style="-fx-background-color: transparent; -fx-text-fill: #C0C2CB; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" />
                <Button text="Settings" maxWidth="Infinity" onAction="#goToSettings" style="-fx-background-color: transparent; -fx-text-fill: #C0C2CB; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" />
                <Region VBox.vgrow="ALWAYS" />

                <HBox spacing="10.0" prefHeight="56.0" alignment="CENTER_LEFT"
                      style="-fx-background-color: #232838; -fx-background-radius: 8; -fx-padding: 8;"
                      onMouseClicked="#goToSettings">
                    <children>
                        <ImageView fx:id="profileImageView" fitWidth="36.0" fitHeight="36.0" preserveRatio="true">
                            <clip>
                                <Circle radius="18" centerX="18" centerY="18" />
                            </clip>
                        </ImageView>
                        <VBox spacing="1.0">
                            <children>
                                <Label fx:id="sidebarNameLabel" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: white;" />
                                <Label fx:id="sidebarEmailLabel" style="-fx-font-size: 10px; -fx-text-fill: #8C919E;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Button text="Logout" maxWidth="Infinity" onAction="#logout" style="-fx-background-color: transparent; -fx-text-fill: #E64D4D; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" />
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="24.0">
            <padding><Insets top="32.0" left="36.0" right="36.0" bottom="20.0" /></padding>
            <children>
                <Label fx:id="welcomeLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1C2130;" />

                <HBox spacing="20.0">
                    <children>

                        <VBox fx:id="corporateStatsBox" spacing="8.0" prefHeight="100.0"
                              style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18;">
                            <children>
                                <Label text="Company" style="-fx-font-size: 12px; -fx-text-fill: #8C919E;" />
                                <Label fx:id="companyNameLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1C2130;" />
                                <Label text="Account Type: Business" style="-fx-font-size: 11px; -fx-text-fill: #3868F2;" />
                            </children>
                        </VBox>

                        <VBox fx:id="enterpriseStatsBox" spacing="8.0" prefHeight="100.0"
                              style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18;">
                            <children>
                                <Label text="Team Activity" style="-fx-font-size: 12px; -fx-text-fill: #8C919E;" />
                                <Label fx:id="teamActivityLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1C2130;" />
                                <Label text="Enterprise Account" style="-fx-font-size: 11px; -fx-text-fill: #21B373;" />
                            </children>
                        </VBox>
                        <VBox spacing="8.0" prefWidth="230.0" prefHeight="100.0" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18;">
                            <children>
                                <Label text="Total Spent (This Month)" style="-fx-font-size: 12px; -fx-text-fill: #8C919E;" />
                                <Label fx:id="totalSpentLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #E64D4D;" />
                            </children>
                        </VBox>
                        <VBox spacing="8.0" prefWidth="230.0" prefHeight="100.0" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18;">
                            <children>
                                <Label text="Budget Remaining" style="-fx-font-size: 12px; -fx-text-fill: #8C919E;" />
                                <Label fx:id="remainingLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #21B373;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 16;">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Recent Transactions" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="+ Add Expense" onAction="#goToAddExpense" style="-fx-background-color: #3868F2; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold;" />
                            </children>
                        </HBox>
                        <TableView fx:id="expenseTable" prefHeight="400.0">
                            <columns>
                                <TableColumn fx:id="dateColumn" text="Date" prefWidth="150.0" />
                                <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="300.0" />
                                <TableColumn fx:id="categoryColumn" text="Category" prefWidth="180.0" />
                                <TableColumn fx:id="amountColumn" text="Amount" prefWidth="150.0" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>