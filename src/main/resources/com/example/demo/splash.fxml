<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="14.0" maxHeight ="Infinity" maxWidth ="Infinity" prefHeight="700" prefWidth="1300"
      style="-fx-background-color: linear-gradient(to bottom right, #1C2130, #26314F);"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo.controller.SplashController">

    <ImageView fitWidth="96.0" fitHeight="96.0" preserveRatio="true" styleClass="logo-image">
        <image>
            <Image url="@images/logo.png" />
        </image>
    </ImageView>

    <Label text="ExpenseTracker" styleClass="app-title" />
    <Label text="Track smarter. Spend wiser." styleClass="app-subtitle" />

    <ProgressBar prefWidth="300.0" styleClass="splash-progress" />

</VBox>