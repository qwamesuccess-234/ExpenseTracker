<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root"
      alignment="CENTER"
      spacing="18.0"
      maxHeight ="-Infinity"
      maxWidth ="-Infinity"
      prefHeight="800"
      prefWidth="1200"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo.controller.SplashController"
      styleClass="splash-root">

    <ImageView fitWidth="96.0" fitHeight="96.0" preserveRatio="true" styleClass="logo-image">
        <image>
            <Image url="@images/logo.png" />
        </image>
    </ImageView>

    <Label text="ExpenseTracker" styleClass="app-title" />
    <Label text="Track smarter. Spend wiser." styleClass="app-subtitle" />

    <ProgressBar prefWidth="300.0" styleClass="splash-progress" />

</VBox>