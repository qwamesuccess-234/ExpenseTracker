<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="1300.0" prefHeight="700.0" maxWidth="Infinity" maxHeight="Infinity"
            style="-fx-background-color: #F5F6FA;"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo.controller.TeamController">

    <left>
        <VBox prefWidth="260.0" spacing="6.0" style="-fx-background-color: #1C2130;">
            <padding><Insets top="32.0" left="20.0" right="20.0" /></padding>
            <children>
                <Label text="ExpenseTracker" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
                <Region prefHeight="28.0" />
                <Button text="Dashboard" maxWidth="Infinity" onAction="#goToDashboard" style="-fx-background-color: transparent; -fx-text-fill: #C0C2CB; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" />
                <Button text="Team" maxWidth="Infinity" style="-fx-background-color: #3868F2; -fx-text-fill: white; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT; -fx-padding: 12;" />
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0">
            <padding><Insets top="32.0" left="36.0" right="36.0" /></padding>
            <children>
                <Label text="Team Members" style="-fx-font-size: 22px; -fx-font-weight: bold;" />

                <HBox spacing="12.0">
                    <children>
                        <TextField fx:id="memberEmailField" promptText="Member's registered email" prefWidth="280.0" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E1E8;" />
                        <Button text="+ Add Member" onAction="#handleAddMember" style="-fx-background-color: #3868F2; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold;" />
                    </children>
                </HBox>

                <TableView fx:id="membersTable" prefHeight="500.0">
                    <columns>
                        <TableColumn fx:id="nameColumn" text="Name" prefWidth="250.0" />
                        <TableColumn fx:id="emailColumn" text="Email" prefWidth="300.0" />
                        <TableColumn fx:id="typeColumn" text="Account Type" prefWidth="180.0" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>